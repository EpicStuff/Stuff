{
	"name": "theia-fixes",
	"version": "0.1.0",
	"description": "Native Eclipse Theia fixes including persistent source code folding.",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"lib",
		"src",
		"README.md"
	],
	"exports": {
		"./lib/browser/theia-fixes-frontend-module": "./lib/browser/theia-fixes-frontend-module.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf lib",
		"test": "node --test test/*.test.mjs"
	},
	"peerDependencies": {
		"@theia/core": ">=1.75.0 <2.0.0",
		"@theia/editor": ">=1.75.0 <2.0.0",
		"@theia/monaco": ">=1.75.0 <2.0.0"
	},
	"devDependencies": {
		"typescript": "~5.9.3"
	},
	"theiaExtensions": [
		{
			"frontend": "lib/browser/theia-fixes-frontend-module"
		}
	],
	"keywords": [
		"theia-extension",
		"theia",
		"folding",
		"persistence"
	]
}
