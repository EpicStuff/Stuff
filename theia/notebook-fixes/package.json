{
	"name": "theia-notebook-fixes",
	"version": "0.1.1",
	"description": "Native Eclipse Theia notebook compatibility fixes and cell input folding.",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"lib",
		"src",
		"LICENSE",
		"README.md"
