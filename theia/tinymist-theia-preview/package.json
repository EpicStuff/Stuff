{
	"name": "tinymist-theia-preview",
	"displayName": "Tinymist Theia Preview",
	"description": "Opens independent Tinymist previews in Theia webview panels.",
	"version": "0.2.0",
	"publisher": "epicstuff",
	"repository": {
		"type": "git",
		"url": "https://github.com/EpicStuff/Stuff.git",
		"directory": "theia/tinymist-theia-preview"
	},
	"engines": {
		"vscode": "^1.101.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:typst"
	],
	"extensionDependencies": [
		"myriad-dreamin.tinymist"
	],
	"contributes": {
		"configurationDefaults": {
			"tinymist.previewer": "epicstuff.tinymist-theia-preview"
		}
	}
}
